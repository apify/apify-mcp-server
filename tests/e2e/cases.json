        "UI_MODE": "apps"
      }
    },
    "errors": {
      "args": [
        "--tools=actors,docs,runs,storage"
      ],
      "excludeFromAll": true
    },
    "actor-details": {
      "args": [
        "--tools=actors,docs,runs,storage"
      ],
      "excludeFromAll": true
    },
    "tasks": {
      "args": [
        "--tools=actors,docs,runs,storage"
      ],
      "excludeFromAll": true
    },
    "abort": {
      "args": [
        "--tools=actors,docs,runs,storage"
      ],
      "excludeFromAll": true
    },
    "http-docs": {
      "url": "${E2E_HTTP_BASE}?tools=docs"
    },
    "http-storage": {
      "url": "${E2E_HTTP_BASE}?tools=storage"
    },
    "http-ui-apps": {

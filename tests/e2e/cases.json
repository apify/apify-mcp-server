{
  "configs": {
    "default": {},
    "cat-actors": {
      "args": [
        "--tools=actors"
      ]
    },
    "cat-docs": {
      "args": [
        "--tools=docs"
      ]
    },
    "cat-runs": {
      "args": [
        "--tools=runs"
      ]
    },
    "cat-storage": {
      "args": [
        "--tools=storage"
      ]
    },
    "cat-dev": {
      "args": [
        "--tools=dev"
      ]
    },
    "cat-all": {
      "args": [
        "--tools=actors,docs,runs,storage"
      ]
    },
    "tools-empty": {
      "args": [
        "--tools="
      ]
    },
    "actors-empty": {
      "args": [
        "--actors="
      ]
    },
    "both-empty": {
      "args": [
        "--tools=",
        "--actors="
      ]
    },
    "actor-single": {
      "args": [
        "--actors=apify/rag-web-browser"
      ]
    },
    "actor-multi": {
      "args": [
        "--actors=apify/rag-web-browser,apify/normal-mode-test-actor"
      ]
    },
    "actor-via-tools": {
      "args": [
        "--tools=apify/rag-web-browser"
      ]
    },
    "tool-by-name": {
      "args": [
        "--tools=search-actors"
      ]
    },
    "retired-add-actor": {
      "args": [
        "--tools=add-actor"
      ]
    },
    "retired-experimental": {
      "args": [
        "--tools=experimental"
      ]
    },
    "retired-preview": {
      "args": [
        "--tools=preview"
      ]
    },
    "retired-mixed": {
      "args": [
        "--tools=actors,add-actor"
      ]
    },
    "merge-compat": {
      "args": [
        "--tools=actors",
        "--actors=apify/rag-web-browser"
      ]
    },
    "ui-apps": {
      "args": [
        "--ui=apps"
      ]
    },
    "ui-default": {
      "args": [
        "--ui=default"
      ]
    },
    "ui-auto": {
      "args": [
        "--ui=auto"
      ]
    },
    "full-apps": {
      "args": [
        "--tools=actors,docs,runs,storage",
        "--ui=apps"
      ]
    },
    "mcp-proxy": {
      "args": [
        "--tools=apify/example-mcp-server"
      ]
    },
    "no-token": {
      "args": [
        "--tools=docs"
      ],
      "env": {
        "APIFY_TOKEN": null
      }
    },
    "http-docs": {
      "url": "${E2E_HTTP_BASE}?tools=docs"
    },
    "http-storage": {
      "url": "${E2E_HTTP_BASE}?tools=storage"
    },
    "http-ui-apps": {
      "url": "${E2E_HTTP_BASE}?ui=apps"
    },
    "http-payment-skyfire": {
      "url": "${E2E_HTTP_BASE}?payment=skyfire"
    }
  },

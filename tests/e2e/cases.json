    },
    "http-payment-skyfire": {
      "url": "${E2E_HTTP_BASE}?payment=skyfire"
    }
  },
  "cases": [
    {
      "id": "server info",
      "configs": [
        "__all__"
      ],
      "args": [],
      "assert": ".serverInfo.name == \"apify-mcp-server\" and (.capabilities | has(\"tools\") and has(\"tasks\") and has(\"resources\") and has(\"prompts\") and has(\"logging\")) and ((.toolNames // []) | type == \"array\")"
    },
    {
      "id": "ping",
      "configs": [
        "__all__"
      ],
      "args": [
        "ping"
      ],
      "assert": ".success == true"
    },
    {
      "id": "tools list",
      "configs": [
        "__all__"
      ],
      "args": [
        "tools-list",
        "--full"
      ],
      "assert": "type == \"array\" and all(.[]; has(\"name\") and has(\"description\") and has(\"inputSchema\"))"
    },
    {
      "id": "prompts list",
      "configs": [
        "__all__"
      ],
      "args": [
        "prompts-list"
      ],
      "assert": ". == []"
    },
    {
      "id": "resources list",
      "configs": [
        "__all__"
      ],
      "args": [
        "resources-list"
      ],
      "assert": "type == \"array\""
    },
    {
      "id": "resource templates",
      "configs": [
        "__all__"
      ],
      "args": [
        "resources-templates-list"
      ],
      "assert": "length == 5 and all(.[]; has(\"uriTemplate\") and has(\"name\"))"
    },
    {
      "id": "logging set level",
      "configs": [
        "__all__"
      ],
      "args": [
        "logging-set-level",
        "debug"
      ],
      "assert": ".level == \"debug\""
    },
    {
      "id": "rejects unknown tool",
      "configs": [
        "errors"
      ],
      "args": [
        "tools-call",
        "does-not-exist"
      ],
      "expectError": true,
      "assert": ".error | test(\"was not found\")"
    },
    {
      "id": "rejects missing required argument",
      "configs": [
        "errors"
      ],
      "args": [
        "tools-call",
        "get-key-value-store-record"
      ],
      "expectError": true,
      "assert": ".error | test(\"must have required property\")"
    },
    {
      "id": "rejects forbidden docs URL",
      "configs": [
        "errors"
      ],
      "args": [
        "tools-call",
        "fetch-apify-docs",
        "url:=\"https://example.com\""
      ],
      "expectError": true,
      "assert": ".isError == true"
    },
    {
      "id": "rejects waitSecs above the maximum",
      "configs": [
        "errors"
      ],
      "args": [
        "tools-call",
        "get-actor-run",
        "runId:=\"x\"",
        "waitSecs:=99"
      ],
      "expectError": true,
      "assert": ".error | test(\"must be <= 45\")"
    },
    {
      "id": "rejects unknown prompt",
      "configs": [
        "errors"
      ],
      "args": [
        "prompts-get",
        "nonexistent"
      ],
      "expectError": true,
      "assert": ".error | test(\"not found\")"
    },
    {
      "id": "rejects a missing dataset resource",
      "configs": [
        "errors"
      ],
      "args": [
        "resources-read",
        "https://api.apify.com/v2/datasets/nope/items"
      ],
      "expectError": true,
      "assert": ".error | test(\"was not found\")"
    },
    {
      "id": "rejects a non-Apify resource URL",
      "configs": [
        "errors"
      ],
      "args": [
        "resources-read",
        "https://example.com"
      ],
      "expectError": true,
      "assert": ".error | test(\"only Apify API URLs\")"
    },
    {
      "id": "rejects resource subscribe",
      "configs": [
        "errors"
      ],
      "args": [
        "resources-subscribe",
        "ui://widget/actor-run.html",
        "/tmp/e2e-subscribe-placeholder.txt"
      ],
      "expectError": true,
      "assert": ".error | test(\"does not support resource subscriptions\")"
    },
    {
      "id": "rejects an unknown Actor",
      "configs": [
        "errors"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"does/not-exist-xyz-123\"",
        "input:={}"
      ],
      "expectError": true,
      "assert": ".isError == true"
    },
    {
      "id": "rejects an MCP Actor without a tool name",
      "configs": [
        "errors"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/example-mcp-server\"",
        "input:={}"
      ],
      "expectError": true,
      "assert": ".isError == true"
    },
    {
      "id": "serves no tools without a token",
      "configs": [
        "no-token"
      ],
      "args": [
        "tools-list"
      ],
      "assert": "([.[].name] | index(\"search-apify-docs\") != null) and ([.[].name] | index(\"call-actor\") == null)"
    },
    {
      "id": "calls an Actor and waits",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}"
      ],
      "capture": {
        "runId": ".structuredContent.runId",
        "datasetId": ".structuredContent.storages.datasets.default.id",
        "kvStoreId": ".structuredContent.storages.keyValueStores.default.id"
      },
      "assert": ".isError != true and .structuredContent.status == \"SUCCEEDED\" and .structuredContent.exitCode == 0 and .structuredContent.storages.datasets.default.itemCount == 1"
    },
    {
      "id": "calls an Actor without waiting",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}",
        "waitSecs:=0"
      ],
      "assert": ".isError != true and .structuredContent.status == \"READY\""
    },
    {
      "id": "calls an Actor with a maxItems cap",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}",
        "callOptions:={\"maxItems\":1}"
      ],
      "assert": ".isError != true and .structuredContent.status == \"SUCCEEDED\""
    },
    {
      "id": "gets the run",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-actor-run",
        "runId:=\"{{runId}}\""
      ],
      "assert": ".isError != true and .structuredContent.status == \"SUCCEEDED\" and .structuredContent.exitCode == 0"
    },
    {
      "id": "gets the run log",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-actor-log",
        "runId:=\"{{runId}}\""
      ],
      "assert": ".isError != true and (.content[0].text | type == \"string\")"
    },
    {
      "id": "lists runs",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-actor-run-list",
        "limit:=3"
      ],
      "assert": ".isError != true and (.structuredContent.items | length <= 3)"
    },
    {
      "id": "gets dataset items",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-items",
        "datasetId:=\"{{datasetId}}\""
      ],
      "assert": ".isError != true and .structuredContent.itemCount == 1 and .structuredContent.items[0].sum == 3 and .structuredContent.items[0].isSumPrime == true"
    },
    {
      "id": "gets dataset items flattened",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-items",
        "datasetId:=\"{{datasetId}}\"",
        "flatten:=true"
      ],
      "assert": ".isError != true and .structuredContent.itemCount == 1 and .structuredContent.items[0].sum == 3"
    },
    {
      "id": "gets dataset metadata",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset",
        "datasetId:=\"{{datasetId}}\""
      ],
      "assert": ".isError != true and (.structuredContent | has(\"id\") and has(\"itemCount\") and has(\"fields\"))"
    },
    {
      "id": "gets dataset schema",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-schema",
        "datasetId:=\"{{datasetId}}\""
      ],
      "assert": ".isError != true and (.structuredContent.schema.items.properties | has(\"sum\") and has(\"isSumPrime\"))"
    },
    {
      "id": "lists datasets",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-list",
        "limit:=3"
      ],
      "assert": ".isError != true and (.structuredContent.items | length <= 3) and (.structuredContent.items | all(has(\"id\")))"
    },
    {
      "id": "gets key-value store metadata",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-key-value-store",
        "keyValueStoreId:=\"{{kvStoreId}}\""
      ],
      "assert": ".isError != true and (.structuredContent | has(\"id\") and has(\"keysPublicUrl\"))"
    },
    {
      "id": "lists key-value store keys",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-key-value-store-keys",
        "keyValueStoreId:=\"{{kvStoreId}}\""
      ],
      "assert": ".isError != true and .structuredContent.count == 5 and ([.structuredContent.items[].key] | sort) == [\"COVER\",\"INPUT\",\"LOG\",\"RESULT\",\"STATS\"]"
    },
    {
      "id": "gets the run INPUT record",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-key-value-store-record",
        "keyValueStoreId:=\"{{kvStoreId}}\"",
        "recordKey:=\"INPUT\""
      ],
      "assert": ".isError != true and .structuredContent.value.firstNumber == 1 and .structuredContent.value.secondNumber == 2"
    },
    {
      "id": "lists key-value stores",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-key-value-store-list",
        "limit:=3"
      ],
      "assert": ".isError != true and (.structuredContent.items | length <= 3)"
    },
    {
      "id": "reads dataset items as a resource",
      "configs": [
        "category-all"
      ],
      "args": [
        "resources-read",
        "https://api.apify.com/v2/datasets/{{datasetId}}/items"
      ],
      "assert": "(.contents[0].text | fromjson) as $d | ($d | type == \"array\") and ($d[0].sum == 3)"
    },
    {
      "id": "reads a key-value record as a resource",
      "configs": [
        "category-all"
      ],
      "args": [
        "resources-read",
        "https://api.apify.com/v2/key-value-stores/{{kvStoreId}}/records/INPUT"
      ],
      "assert": "(.contents[0].text | fromjson) as $d | $d.firstNumber == 1 and $d.secondNumber == 2"
    },
    {
      "id": "searches Actors",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "search-actors",
        "keywords:=\"instagram\"",
        "limit:=3"
      ],
      "assert": "if .isError then (.content[0].text | test(\"allowlist\"; \"i\")) else (.structuredContent | has(\"actors\") and has(\"query\") and has(\"count\")) end"
    },
    {
      "id": "searches the docs",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "search-apify-docs",
        "query:=\"actor input schema\""
      ],
      "assert": "if .isError then (.content[0].text | test(\"allowlist\"; \"i\")) else (.structuredContent | has(\"results\")) end"
    },
    {
      "id": "fetches a docs page",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "fetch-apify-docs",
        "url:=\"https://docs.apify.com/platform/actors\""
      ],
      "assert": "if .isError then (.content[0].text | test(\"HTTP Status|allowlist\"; \"i\")) else (.structuredContent.content | length > 100) end"
    },
    {
      "id": "fetches Actor details with defaults",
      "configs": [
        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/rag-web-browser\""
      ],
      "assert": ".isError != true and (.structuredContent | has(\"actorInfo\") and has(\"inputSchema\") and has(\"readme\"))"
    },
    {
      "id": "fetches Actor details, input schema only",
      "configs": [
        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/rag-web-browser\"",
        "output:={\"inputSchema\":true}"
      ],
      "assert": ".isError != true and (.structuredContent | keys) == [\"inputSchema\"]"
    },
    {
      "id": "fetches Actor details, description only",
      "configs": [
        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/rag-web-browser\"",
        "output:={\"description\":true}"
      ],
      "assert": ".isError != true and (.structuredContent | keys) == [\"actorInfo\"] and (.structuredContent.actorInfo | has(\"description\"))"
    },
    {
      "id": "fetches Actor details, stats only",
      "configs": [
        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/rag-web-browser\"",
        "output:={\"stats\":true}"
      ],
      "assert": ".isError != true and (.structuredContent.actorInfo | has(\"stats\"))"
    },
    {
      "id": "fetches Actor details, pricing only",
      "configs": [
        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/rag-web-browser\"",
        "output:={\"pricing\":true}"
      ],
      "assert": ".isError != true and (.structuredContent.actorInfo | has(\"pricing\"))"
    },
    {
      "id": "fetches Actor details, readme only",
      "configs": [
        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/rag-web-browser\"",
        "output:={\"readme\":true}"
      ],
      "assert": ".isError != true and (.structuredContent | keys) == [\"readme\"]"
    },
    {
      "id": "fetches Actor details, mcp tools only",
      "configs": [
        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/rag-web-browser\"",
        "output:={\"mcpTools\":true}"
      ],
      "assert": ".isError != true and .structuredContent.mcpTools == \"Note: This Actor is not an MCP server and does not expose MCP tools.\""
    },
    {
      "id": "fetches Actor details, description and readme",
      "configs": [
        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/rag-web-browser\"",
        "output:={\"description\":true,\"readme\":true}"
      ],
      "assert": ".isError != true and (.structuredContent | has(\"actorInfo\") and has(\"readme\")) and (.structuredContent | has(\"inputSchema\") | not)"
    },
    {
      "id": "fetches Actor details, rating and metadata",
      "configs": [
        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/rag-web-browser\"",
        "output:={\"rating\":true,\"metadata\":true}"
      ],

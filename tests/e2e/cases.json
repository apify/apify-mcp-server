    {
      "id": "rejects unknown tool",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "does-not-exist"
      ],
      "expectError": true,
      "assert": ".error | test(\"was not found\")"
    },
    {
      "id": "rejects missing required argument",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-key-value-store-record"
      ],
      "expectError": true,
      "assert": ".error | test(\"must have required property\")"
    },
    {
      "id": "rejects forbidden docs URL",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "fetch-apify-docs",
        "url:=\"https://example.com\""
      ],
      "assert": ".isError == true"
    },
    {
      "id": "rejects waitSecs above the maximum",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-actor-run",
        "runId:=\"x\"",
        "waitSecs:=99"
      ],
      "expectError": true
    },
    {
      "id": "rejects unknown prompt",
      "configs": [
        "cat-all"
      ],
      "args": [
        "prompts-get",
        "nonexistent"
      ],
      "expectError": true
    },
    {
      "id": "rejects a missing dataset resource",
      "configs": [
        "cat-all"
      ],
      "args": [
        "resources-read",
        "https://api.apify.com/v2/datasets/nope/items"
      ],
      "expectError": true
    },
    {
      "id": "rejects a non-Apify resource URL",
      "configs": [
        "cat-all"
      ],
      "args": [
        "resources-read",
        "https://example.com"
      ],
      "expectError": true
    },
    {
      "id": "rejects resource subscribe",
      "configs": [
        "cat-all"
      ],
      "args": [
        "resources-subscribe",
        "ui://widget/actor-run.html"
      ],
      "expectError": true
    },
    {
      "id": "rejects an unknown Actor",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"does/not-exist-xyz-123\"",
        "input:={}"
      ],
      "redact": true,
      "assert": ".isError == true"
    },
    {
      "id": "rejects an MCP Actor without a tool name",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/example-mcp-server\"",
        "input:={}"
      ],
      "redact": true,
      "assert": ".isError == true"
    },
    {
      "id": "serves no tools without a token",
      "configs": [
        "no-token"
      ],
      "args": [
        "tools-list"
      ]
    },
    {
      "id": "calls an Actor and waits",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}"
      ],
      "redact": true,
      "capture": {
        "runId": ".structuredContent.runId",
        "datasetId": ".structuredContent.storages.datasets.default.id",
        "kvStoreId": ".structuredContent.storages.keyValueStores.default.id"
      },
      "assert": ".isError != true and (.structuredContent.status == \"SUCCEEDED\")"
    },
    {
      "id": "calls an Actor without waiting",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}",
        "waitSecs:=0"
      ],
      "redact": true
    },
    {
      "id": "calls an Actor with a maxItems cap",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}",
        "callOptions:={\"maxItems\":1}"
      ],
      "redact": true
    },
    {
      "id": "gets the run",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-actor-run",
        "runId:=\"{{runId}}\""
      ],
      "redact": true
    },
    {
      "id": "gets the run log",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-actor-log",
        "runId:=\"{{runId}}\""
      ],
      "redact": true
    },
    {
      "id": "lists runs",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-actor-run-list",
        "limit:=3"
      ],
      "redact": true
    },
    {
      "id": "gets dataset items",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-items",
        "datasetId:=\"{{datasetId}}\""
      ],
      "redact": true
    },
    {
      "id": "gets dataset items flattened",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-items",
        "datasetId:=\"{{datasetId}}\"",
        "flatten:=true"
      ],
      "redact": true
    },
    {
      "id": "gets dataset metadata",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-dataset",
        "datasetId:=\"{{datasetId}}\""
      ],
      "redact": true
    },
    {
      "id": "gets dataset schema",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-schema",
        "datasetId:=\"{{datasetId}}\""
      ],
      "redact": true
    },
    {
      "id": "lists datasets",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-list",
        "limit:=3"
      ],
      "redact": true
    },
    {
      "id": "gets key-value store metadata",
      "configs": [
        "cat-all"
      ],
      "args": [
        "tools-call",
        "get-key-value-store",
        "keyValueStoreId:=\"{{kvStoreId}}\""

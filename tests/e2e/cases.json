    },
    {
      "id": "starts a task to cancel",
      "configs": [
        "tasks"
      ],
      "args": [
        "tools-call",
        "--detach",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":9,\"secondNumber\":9}"
      ],
      "capture": {
        "cancelTaskId": ".taskId"
      },
      "assert": ".status == \"working\""
    },
    {
      "id": "cancels a task",
      "configs": [
        "tasks"
      ],
      "args": [
        "tasks-cancel",
        "{{cancelTaskId}}"
      ],
      "assert": ".taskId == \"{{cancelTaskId}}\" and .status == \"cancelled\""
    },
    {
      "id": "rejects an unknown task",
      "configs": [
        "errors"
      ],
      "args": [
        "tasks-get",
        "0000000000000000000000000000dead"
      ],
      "expectError": true,
      "assert": ".error | test(\"not found\")"
    },
    {
      "id": "starts a run to abort",
      "configs": [
        "abort"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}",
        "waitSecs:=0"
      ],
      "capture": {
        "abortRunId": ".structuredContent.runId"
      },
      "assert": ".isError != true and .structuredContent.status == \"READY\""
    },
    {
      "id": "aborts the run",
      "configs": [
        "abort"
      ],
      "args": [
        "tools-call",
        "abort-actor-run",
        "runId:=\"{{abortRunId}}\""
      ],
      "assert": ".isError != true and (.structuredContent.status == \"ABORTING\" or .structuredContent.status == \"ABORTED\")"
    },
    {
      "id": "calls the search-actors widget",
      "configs": [
        "full-apps"
      ],
      "args": [
        "tools-call",
        "search-actors-widget",
        "keywords:=\"instagram\"",
        "limit:=2"
      ],
      "assert": ".isError != true and (._meta | has(\"ui\")) and (.structuredContent | has(\"actors\") and has(\"widgetActors\"))"
    },
    {
      "id": "calls the fetch-actor-details widget",
      "configs": [
        "full-apps"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details-widget",
        "actor:=\"apify/rag-web-browser\""
      ],
      "assert": ".isError != true and (._meta | has(\"ui\")) and (.structuredContent | has(\"actorDetails\"))"
    },
    {
      "id": "calls the call-actor widget",
      "configs": [
        "full-apps"
      ],
      "args": [
        "tools-call",
        "call-actor-widget",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}"
      ],
      "capture": {
        "widgetRunId": ".structuredContent.runId"
      },
      "assert": ".isError != true and (._meta | has(\"ui\")) and (.structuredContent | has(\"runId\") and has(\"status\"))"
    },
    {
      "id": "waits for the widget run to finish",
      "configs": [
        "full-apps"
      ],
      "args": [
        "tools-call",
        "get-actor-run",
        "runId:=\"{{widgetRunId}}\"",
        "waitSecs:=45"
      ],
      "assert": ".isError != true and .structuredContent.status == \"SUCCEEDED\""
    },
    {
      "id": "calls the get-actor-run widget",
      "configs": [
        "full-apps"
      ],
      "args": [
        "tools-call",
        "get-actor-run-widget",
        "runId:=\"{{widgetRunId}}\""
      ],
      "assert": ".isError != true and (._meta | has(\"ui\")) and .structuredContent.status == \"SUCCEEDED\""
    },
    {
      "id": "calls report-problem",
      "configs": [
        "category-dev"
      ],
      "args": [
        "tools-call",
        "report-problem",
        "message:=\"e2e probe\""
      ],
      "assert": ".isError == false and .content[0].text == \"Problem reported. Thank you \u2014 this helps the Apify team improve its tools.\""
    },
    {
      "id": "gets a text/plain record",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-key-value-store-record",
        "keyValueStoreId:=\"{{kvStoreId}}\"",
        "recordKey:=\"LOG\""
      ],
      "assert": ".isError != true and .structuredContent.contentType == \"text/plain\" and .structuredContent.value == \"Scrape finished. 3 book(s) pushed.\""
    },
    {
      "id": "gets an image/png record",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-key-value-store-record",
        "keyValueStoreId:=\"{{kvStoreId}}\"",
        "recordKey:=\"COVER\""
      ],
      "assert": ".isError != true and .structuredContent.contentType == \"image/png\""
    },
    {
      "id": "gets dataset items with field projection",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-items",
        "datasetId:=\"{{datasetId}}\"",
        "fields:=\"sum,isSumPrime\""
      ],
      "assert": ".isError != true and .structuredContent.items[0] == {\"isSumPrime\":true,\"sum\":3}"
    },
    {
      "id": "gets dataset items with omit",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-items",
        "datasetId:=\"{{datasetId}}\"",
        "omit:=\"math\""
      ],
      "assert": ".isError != true and (.structuredContent.items[0] | has(\"math\") | not) and .structuredContent.items[0].sum == 3"
    },
    {
      "id": "gets dataset items paged and descending",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-items",
        "datasetId:=\"{{datasetId}}\"",
        "limit:=1",
        "offset:=0",
        "desc:=true"
      ],
      "assert": ".isError != true and .structuredContent.limit == 1 and (.structuredContent.items | length == 1)"
    },
    {
      "id": "gets dataset items cleaned",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-items",
        "datasetId:=\"{{datasetId}}\"",
        "clean:=true"
      ],
      "assert": ".isError != true and .structuredContent.itemCount == 1"
    },
    {
      "id": "searches Actors with an offset",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "search-actors",
        "keywords:=\"instagram\"",
        "limit:=2",
        "offset:=2"
      ],
      "assert": "if .isError then (.content[0].text | test(\"allowlist\"; \"i\")) else (.structuredContent.actors | type == \"array\") end"
    },
    {
      "id": "searches the docs with paging",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "search-apify-docs",
        "query:=\"actor input schema\"",
        "limit:=2",
        "offset:=1"
      ],
      "assert": "if .isError then (.content[0].text | test(\"allowlist\"; \"i\")) else (.structuredContent | has(\"results\")) end"
    },
    {
      "id": "lists runs filtered by status",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-actor-run-list",
        "limit:=2",
        "status:=\"SUCCEEDED\"",
        "desc:=true"
      ],
      "assert": ".isError != true and .structuredContent.desc == true and (.structuredContent.items | all(.status == \"SUCCEEDED\"))"
    },
    {
      "id": "gets a truncated run log",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-actor-log",
        "runId:=\"{{runId}}\"",
        "lines:=5"
      ],
      "assert": ".isError != true and (.content[0].text | length > 0)"
    },
    {
      "id": "gets dataset schema with a limit",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-schema",
        "datasetId:=\"{{datasetId}}\"",
        "limit:=1"
      ],
      "assert": ".isError != true and (.structuredContent.schema.items.properties | has(\"sum\"))"
    },
    {
      "id": "lists store keys with a limit",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-key-value-store-keys",
        "keyValueStoreId:=\"{{kvStoreId}}\"",
        "limit:=2"
      ],
      "assert": ".isError != true and .structuredContent.limit == 2 and (.structuredContent.items | length <= 2)"
    },
    {
      "id": "lists unnamed datasets descending",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-dataset-list",
        "limit:=2",
        "unnamed:=true",
        "desc:=true"
      ],
      "assert": ".isError != true and .structuredContent.desc == true and (.structuredContent.items | all(.name == null))"
    },
    {
      "id": "gets the run with a wait",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "get-actor-run",
        "runId:=\"{{runId}}\"",
        "waitSecs:=5"
      ],
      "assert": ".isError != true and .structuredContent.status == \"SUCCEEDED\""
    },
    {
      "id": "calls an Actor with run options",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}",
        "callOptions:={\"memory\":512,\"timeout\":60}"
      ],
      "assert": ".isError != true and .structuredContent.status == \"SUCCEEDED\""
    },
    {
      "id": "reads the run as a resource",
      "configs": [
        "category-all"
      ],
      "args": [
        "resources-read",
        "https://api.apify.com/v2/actor-runs/{{runId}}"
      ],
      "assert": "(.contents[0].text | fromjson.data.status) == \"SUCCEEDED\""
    },
    {
      "id": "reads the run log as a resource",
      "configs": [
        "category-all"
      ],
      "args": [
        "resources-read",
        "https://api.apify.com/v2/logs/{{runId}}"
      ],
      "assert": ".contents[0].mimeType == \"text/plain; charset=utf-8\" and (.contents[0].text | length > 0)"
    },
    {
      "id": "reads store keys as a resource",
      "configs": [
        "category-all"
      ],
      "args": [
        "resources-read",
        "https://api.apify.com/v2/key-value-stores/{{kvStoreId}}/keys"
      ],
      "assert": "(.contents[0].text | fromjson.data.items | length > 0)"
    },
    {
      "id": "gets the finished task result",
      "configs": [
        "tasks"
      ],
      "args": [
        "tasks-result",
        "{{taskId}}"
      ],
      "pollWhileWorking": true,
      "assert": "(.content[0].text | fromjson.status) == \"SUCCEEDED\""
    }
  ]
}

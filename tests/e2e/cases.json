        "actor-details"
      ],
      "args": [
        "tools-call",
        "fetch-actor-details",
        "actor:=\"apify/normal-mode-test-actor\"",
        "output:={\"mcpTools\":true}"
      ],
      "assert": ".isError != true and .structuredContent.mcpTools == \"Note: This Actor is not an MCP server and does not expose MCP tools.\""
    },
    {
      "id": "calls a dedicated Actor tool",
      "configs": [
        "actor-multi"
      ],
      "args": [
        "tools-call",
        "apify--normal-mode-test-actor",
        "firstNumber:=3",
        "secondNumber:=4"
      ],
      "assert": ".isError != true and .structuredContent.status == \"SUCCEEDED\" and .structuredContent.exitCode == 0"
    },
    {
      "id": "calls a tool through the MCP proxy",
      "configs": [
        "category-all"
      ],
      "args": [
        "tools-call",
        "call-actor",
        "actor:=\"apify/example-mcp-server:add\"",
        "input:={\"firstNumber\":5,\"secondNumber\":6}"
      ],
      "assert": "if .isError then (.content[0].text | test(\"Failed to connect|MCP server\"; \"i\")) else true end"
    },
    {
      "id": "reads the search-actors widget",
      "configs": [
        "full-apps"
      ],
      "args": [
        "resources-read",
        "ui://widget/search-actors.html"
      ],
      "assert": ".contents[0].mimeType == \"text/html;profile=mcp-app\" and (.contents[0].text | length > 1000)"
    },
    {
      "id": "reads the actor-run widget",
      "configs": [
        "full-apps"
      ],
      "args": [
        "resources-read",
        "ui://widget/actor-run.html"
      ],
      "assert": ".contents[0].mimeType == \"text/html;profile=mcp-app\" and (.contents[0].text | length > 1000)"
    },
    {
      "id": "starts a detached task",
      "configs": [
        "tasks"
      ],
      "args": [
        "tools-call",
        "--detach",
        "call-actor",
        "actor:=\"apify/normal-mode-test-actor\"",
        "input:={\"firstNumber\":1,\"secondNumber\":2}"
      ],
      "capture": {
        "taskId": ".taskId"
